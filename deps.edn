;; taia.ds — Polylith workspace. Bricks declare paths only; libraries live here
;; (for the development project) and in projects/taia-ds/deps.edn (the jar).
{:aliases
 {:dev {:extra-paths ["development/src"
                      "components/datastar/src"
                      "components/datastar/resources"
                      "components/state-machines/src"
                      "components/logging/src"
                      "components/extensions/src"]
        :extra-deps {org.clojure/clojure        {:mvn/version "1.12.6"}
                     dev.data-star.clojure/sdk  {:mvn/version "1.0.0-RC8"}
                     dev.data-star.clojure/ring {:mvn/version "1.0.0-RC8"}
                     dev.onionpancakes/chassis  {:mvn/version "1.0.365"}
                     com.cnuernber/charred      {:mvn/version "1.034"}
                     ring/ring-core             {:mvn/version "1.15.0"}
                     org.clojure/core.async     {:mvn/version "1.9.808-alpha1"}
                     metosin/malli              {:mvn/version "0.12.0"}
                     com.brunobonacci/mulog     {:mvn/version "0.9.0"}
                     com.hyperfiddle/rcf        {:mvn/version "20220926-202227"}
                     tortue/spy                 {:mvn/version "2.13.0"}
                     ;; development server only (not shipped in the jar)
                     ring/ring-jetty-adapter    {:mvn/version "1.15.0"}
                     metosin/reitit             {:mvn/version "0.7.2"}}}

  :test {:jvm-opts ["-Dhyperfiddle.rcf.generate-tests=true"]
         :extra-deps {lambdaisland/kaocha {:mvn/version "1.91.1392"}
                      hickory/hickory     {:mvn/version "0.7.1"}
                      org.jsoup/jsoup     {:mvn/version "1.9.2"}}
         :main-opts ["-m" "kaocha.runner"]}

  :poly {:extra-deps {polylith/clj-poly {:mvn/version "0.3.33"}}
         :main-opts ["-m" "polylith.clj.core.poly-cli.core"]}

  :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.14"}
                 slipset/deps-deploy            {:mvn/version "0.2.5"}}
          :ns-default build}}}
