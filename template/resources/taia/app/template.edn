{:description  "A taia.ds web app: Polylith workspace, async Jetty, bb dev, counter + live counter"
 ;; the taia.ds release the generated app depends on: bump with every release,
 ;; next to the README pin (bb template-test checks they agree)
 :taia-version "0.4.1"
 :port         7788
 :nrepl-port   7789
 :e2e-port     7799   ; where `bb e2e-test` starts its own copy of the app
 ;; namespaced directories cannot be named under root/, so they come in here
 :transform    [["base-src"  "bases/web/src/{{top/file}}/{{main/file}}/web"]
                ["base-test" "bases/web/test/{{top/file}}/{{main/file}}/web"]
                ["project"   "projects/{{main}}"]]}
