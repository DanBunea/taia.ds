{:tasks
 {:init (println "taia.ds")
  dev          {:doc "Start the examples app on http://localhost:7788 (nREPL 7789)"
                :task (clojure "-M:dev -m dev")}
  test         {:doc "Run the unit tests (Kaocha + RCF inline tests, examples included)"
                :task (clojure "-M:dev:test")}
  check        {:doc "Validate the Polylith workspace"
                :task (clojure "-M:poly check")}
  info         {:doc "Show the Polylith workspace"
                :task (clojure "-M:poly info")}
  format       {:doc "Format all source files"
                :task (shell "cljfmt fix")}
  format:check {:doc "Check formatting"
                :task (shell "cljfmt check")}
  e2e-test     {:doc "Playwright end-to-end suite against the examples app. Usage: bb e2e-test [spec] [--headed]; needs Node >= 18"
                :task (load-file "scripts/e2e.clj")}
  flow-gif     {:doc "Re-render docs/img/counter-flow.gif from the animated SVG (needs e2e deps: npm ci in e2e/)"
                :task (shell {:dir "e2e"} "node render-flow.mjs ../docs/img/counter-flow.svg ../docs/img/counter-flow.gif 10 13")}
  api-index    {:doc "Regenerate docs/api.md from the brick interface namespaces"
                :task (load-file "scripts/api_index.clj")}
  jar          {:doc "Build target/taia.ds-<version>.jar (pass :version \"x.y.z\" to override)"
                :task (apply clojure "-T:build jar" *command-line-args*)}
  install      {:doc "Build and install the jar into ~/.m2"
                :task (apply clojure "-T:build install" *command-line-args*)}
  deploy       {:doc "Build and deploy to Clojars (needs CLOJARS_USERNAME / CLOJARS_PASSWORD)"
                :task (apply clojure "-T:build deploy" *command-line-args*)}}}
